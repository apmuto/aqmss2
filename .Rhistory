#----
#2.2 Naive TWFE vs. Callaway-Sant´anna estimator
#a)
mpdta = mpdta %>%
mutate(treated_post = ifelseifelse(first.treat > 0 & year >= first.treat, 1, 0))
##
#----
#2.2 Naive TWFE vs. Callaway-Sant´anna estimator
#a)
mpdta = mpdta %>%
mutate(treated_post = ifelse(first.treat > 0 & year >= first.treat, 1, 0))
naive_twfe = feols(lemp ~ treated_post|countryreal+year, data = mpdta)
naive_twfe = feols(lemp ~ treated_post|countyreal+year, data = mpdta)
summary(naive_twfe)
###
#b)
out <- att_gt(
yname = "lemp",
gname = "first.treat",
idname = "countyreal",
tname = "year",
xformla = ~1,
data = mpdta,
est_method = "reg"
)
summary(out)
ggdid(out, ylim = c(-.25, .1))
#c)
es <- aggte(out, type = "dynamic")
summary(es)
ggdid(es)
group_effects <- aggte(out, type = "group")
group_effects
summary(naive_twfe)
modelsummary(list("Two Way Fixed Effect"=naive_twfe,"Callaway-Santanna"=out,"Event Study Callaway-Santanna"=es))
modelsummary(list("Two Way Fixed Effect"=naive_twfe,"Callaway-Santanna"=out,"Event Study Callaway-Santanna"=es)stars = TRUE,
modelsummary(
list(
"Two Way Fixed Effect" = naive_twfe,
"Callaway-Santanna" = out,
"Event Study Callaway-Santanna" = es
),
stars = TRUE
)
modelsummary(
list(naive_twfe,es,out
),
stars = TRUE
)
modelsummary(
list(naive_twfe,es,out
),
stars = TRUE,
gof_map = c("nobs","r.squared"),
output = "gt"
)
modelsummary(
list(naive_twfe,out,es
),
stars = TRUE,
gof_map = c("nobs","r.squared"),
output = "gt"
)
modelsummary(
list(naive_twfe,out,es
),
