#-----
#2.3.Pre-testing the parallel trends assumption
#a)
out_boot <- att_gt(
yname = "lemp",
gname = "first.treat",
idname = "countyreal",
tname = "year",
xformla = ~1,
data = mpdta,
est_method = "reg",
bstrap = TRUE,
cband = TRUE
)
summary(out_boot)
#P-value for pre-test of parallel trends assumption:  0.16812
#b)
ggdid(out_boot)
ggsave("plot2_p2")
ggsave("plot2_p2.png")
ggsave("plot2_part2_ass6.png")
